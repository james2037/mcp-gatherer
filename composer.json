{
    "name": "your-vendor/mcp-tool-server",
    "description": "MCP Tool Server Implementation",
    "type": "project",
    "require": {
        "php": "^8.1",
        "james2037/mcp-php-server": "dev-master",
        "mtgsdk/mtgsdk": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\Tools\\": "tools/",
            "App\\Resources\\": "resources/",
            "App\\Util\\": "util/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
